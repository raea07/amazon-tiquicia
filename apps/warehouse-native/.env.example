# Public settings for Yuntera Bodega. Nothing here is secret: EXPO_PUBLIC_ values
# are written into the app bundle, which anyone can read. Never put a secret or
# a privileged key behind that prefix. Copy to .env.local to use.

# The API. On a phone, 127.0.0.1 is the phone itself: use your computer's LAN
# address (for example http://192.168.1.20:54321) or an HTTPS tunnel. See the
# README, "Running a native app during development".
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_only

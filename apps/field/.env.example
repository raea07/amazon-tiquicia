# Public settings for the drivers' and warehouse app. Nothing here is secret:
# the publishable key only identifies the project. What a person may do is
# decided by their driver or warehouse record, checked in the database.

# Local development against the stand-in API (pnpm --filter @yuntera/dev-api start):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_only

# Public address of this site.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

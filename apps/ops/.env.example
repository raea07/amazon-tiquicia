# Public settings for the internal console. Nothing here is secret: the
# publishable key only identifies the project. What a staff member may do is
# decided by their row in `staff_members`, checked in the database on every call.

# Local development against the stand-in API (pnpm --filter @yuntera/dev-api start):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_only

# Public address of this site.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Address of the shop. The console tells it when a product was published or changed,
# so shoppers see the change at once instead of within a minute.
NEXT_PUBLIC_SHOP_URL=http://localhost:3000

# Server-only (never NEXT_PUBLIC_): the key the shop asks for before it drops its cached
# catalogue on request. The shop, the seller centre and the console must have the same
# value. A real deployment uses a long random value kept in the host's settings.
SHOP_REFRESH_KEY=local-development-only

# Public settings for the internal console. Nothing here is secret: the
# publishable key only identifies the project. What a staff member may do is
# decided by their row in `staff_members`, checked in the database on every call.

# Local development against the stand-in API (pnpm --filter @yuntera/dev-api start):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_only

# Public address of this site.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Address of the shop. The console tells it when a product was published or changed,
# so shoppers see the change at once instead of within a minute.
NEXT_PUBLIC_SHOP_URL=http://localhost:3000

# Server-only (never NEXT_PUBLIC_): the key the shop asks for before it drops its cached
# catalogue on request. The shop, the seller centre and the console must have the same
# value. A real deployment uses a long random value kept in the host's settings.
SHOP_REFRESH_KEY=local-development-only

# Server-only: the key the apps sign the sign-in limit's hashes and session cookies
# with (packages/next-kit/src/guard.ts). Optional on this machine; a deployment
# needs a random value of 32 characters or more (e.g. `openssl rand -hex 32`),
# the same in all four apps, or sign-in refuses to run.
# AUTH_GUARD_KEY=

# Server-only: which request header names the visitor's address. Leave unset on
# Vercel (its own header is used). Behind your own proxy, the header it writes
# and how many proxies of yours add to it (see guard.ts, clientAddress).
# AUTH_CLIENT_IP_HEADER=x-forwarded-for
# AUTH_CLIENT_IP_HOPS=1

# Public: the Cloudflare Turnstile site key, to show the human check on the sign-in
# forms. Off while unset; switch CAPTCHA protection on in Supabase Auth together.
# NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=

# Only for a production build (`next build && next start`) on this machine
# against a local API: says the readable keys above may be used. Never set it
# on a deployment, self-hosted or not (packages/next-kit/src/guard.ts).
# YUNTERA_LOCAL_RUN=1

# Server-only, for the Versiones panel of Salud del sistema: where the console asks the
# seller centre and the field app which commit they run (the shop's is NEXT_PUBLIC_SHOP_URL).
# Unset, the panel says the address is missing. Not secret.
# YUNTERA_SELLER_URL=http://localhost:3001
# YUNTERA_FIELD_URL=http://localhost:3003

# Server-only: the commit this build is from. Vercel gives VERCEL_GIT_COMMIT_SHA by itself;
# set this only on a host that does not (the output of `git rev-parse HEAD`). Not secret.
# YUNTERA_BUILD_COMMIT=

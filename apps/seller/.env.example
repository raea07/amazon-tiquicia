# Public settings for the seller centre. Nothing here is secret: the publishable
# key only identifies the project, and every request is still checked by the
# database's grants and row-level security.

# Local development against the stand-in API (pnpm --filter @yuntera/dev-api start):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_only

# Public address of this site.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Address of the shop, where the terms and the privacy policy are published.
NEXT_PUBLIC_SHOP_URL=http://localhost:3000

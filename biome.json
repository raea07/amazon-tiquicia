{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.expo",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/.turbo",
      "!**/next-env.d.ts",
      "!packages/db/src/database.types.ts",
      "!packages/brand/src/tokens.css",
      "!packages/brand/styles/tokens.css",
      "!packages/brand/styles/tokens.legacy.css",
      "!packages/brand/styles/carreta-base.css",
      "!packages/brand/assets/app-icons",
      "!packages/brand/assets/lockups",
      "!apps/*/public/icon.svg",
      "!supabase/seed/geo-cr.json",
      "!pnpm-lock.yaml",
      "!**/dist-web",
      "!tools/native-e2e/screenshots",
      "!docs/brand/system"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error", "info"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "apps/seller/**", "apps/ops/**"],
      "linter": {
        "domains": {
          "next": "recommended"
        }
      }
    },
    {
      "includes": ["apps/*-native/**", "packages/expo-kit/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": {
                "skip": [
                  "Text",
                  "Button",
                  "LinkButton",
                  "TextLink",
                  "Alert",
                  "Badge",
                  "EmptyState",
                  "Item"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

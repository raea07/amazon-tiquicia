{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "VERCEL_ENV"],
  "globalPassThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SHOP_URL",
        "NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY",
        "NEXT_PUBLIC_SENTRY_DSN",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "passThroughEnv": [
        "SHOP_REFRESH_KEY",
        "AUTH_GUARD_KEY",
        "AUTH_CLIENT_IP_HEADER",
        "AUTH_CLIENT_IP_HOPS",
        "YUNTERA_LOCAL_RUN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@yuntera/expo-kit#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*-native/app.config.ts",
        "$TURBO_ROOT$/apps/*-native/package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "export:native": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SHOP_URL",
        "APP_VARIANT"
      ]
    },
    "export:web": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist-web/**"],
      "env": [
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SHOP_URL",
        "APP_VARIANT"
      ]
    }
  }
}
